# Copy to .env (never commit .env). One of these two names is read:
ANTHROPIC_API_KEY=
# MY_ANTHROPIC_KEY=

# Optional: route through an internal gateway (no trailing slash, no /v1/messages)
# ANTHROPIC_BASE_URL=

